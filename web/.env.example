# Optional. By default the frontend calls the API via same-origin relative paths (correct for
# production, where one app serves both) and dev's own vite.config.ts proxy forwards API calls
# to the backend dev server automatically. Only set this if the frontend needs to call an API on
# a different origin than whatever serves it (e.g. testing against a deployed API from local dev).
# VITE_API_URL=http://localhost:3999
